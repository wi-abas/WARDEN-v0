{
  "$schema": "https://raw.githubusercontent.com/wi-abas/agent-warden/main/schemas/policy-v1.json",
  "tools": {
    "read_file": { "arguments": ["path"], "required": ["path"] },
    "write_file": { "arguments": ["path", "content"], "required": ["path", "content"] },
    "delete_file": { "arguments": ["path"], "required": ["path"] },
    "send_email": { "arguments": ["to", "subject", "body"], "required": ["to"] }
  },
  "rules": [
    {
      "id": "read-workspace",
      "tool": "read_file",
      "effect": "allow",
      "when": [{ "arg": "path", "op": "startswith", "value": "/workspace/" }]
    },
    {
      "id": "write-workspace",
      "tool": "write_file",
      "effect": "require_approval",
      "when": [{ "arg": "path", "op": "startswith", "value": "/workspace/" }],
      "message": "Writing files needs a human to approve"
    },
    {
      "id": "no-deleting",
      "tool": "delete_file",
      "effect": "deny",
      "message": "Agents may never delete files"
    },
    {
      "id": "email-colleagues",
      "tool": "send_email",
      "effect": "allow",
      "when": [{ "arg": "to", "op": "endswith", "value": "@example.com", "ignore_case": true }]
    }
  ]
}
